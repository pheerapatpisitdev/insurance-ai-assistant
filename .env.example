# Copy to .env.local.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# SECRET — server only. Supabase dashboard → Project Settings → API keys → service_role.
# The back office authenticates with its own PIN, so this key is how the server reaches the
# database. Never commit it and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Back-office login: any 6 digits you choose.
ADMIN_PIN=

# Random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# LINE Messaging API (server only). From LINE Developers → your Messaging API channel:
# Basic settings → Channel secret, and Messaging API → Channel access token (Issue).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app ID, so the calculator can share a quote straight into a LINE chat.
# From LINE Developers → your LINE Login channel → LIFF → the app's LIFF ID.
NEXT_PUBLIC_LIFF_ID=

# Optional fallback for the contact button on /legacy. Normally leave empty: the page asks
# LINE for its own account ID, so the button follows whatever the bot already answers on.
# Set it only to point the sales page somewhere else, or where the live value cannot be read.
# The official account's ID, including the @.
NEXT_PUBLIC_LINE_OA_ID=

# Shared secret for POST /api/alerts/notify, so an outside watchdog (n8n, UptimeRobot) can
# push a downtime warning into the same LINE chat as everything else. Any long random string:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ALERT_WEBHOOK_SECRET=

# Where this app answers, used in the links inside alert messages.
NEXT_PUBLIC_SITE_URL=https://www.advisortool.app
