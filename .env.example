# Copy to .env.local.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# SECRET — server only. Supabase dashboard → Project Settings → API keys → service_role.
# The back office authenticates with its own PIN, so this key is how the server reaches the
# database. Never commit it and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Back-office login: any 6 digits you choose.
ADMIN_PIN=

# Random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# LINE Messaging API (server only). From LINE Developers → your Messaging API channel:
# Basic settings → Channel secret, and Messaging API → Channel access token (Issue).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app ID, so the calculator can share a quote straight into a LINE chat.
# From LINE Developers → your LINE Login channel → LIFF → the app's LIFF ID.
NEXT_PUBLIC_LIFF_ID=

# Facebook Messenger (server only). From Meta for Developers → your app:
# Messenger → Settings → your Page → Generate access token,
# a verify token you choose yourself when adding the webhook callback URL,
# and App settings → Basic → App secret.
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=
FB_APP_SECRET=
