# Copy to .env.local.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# SECRET — server only. Supabase dashboard → Project Settings → API keys → service_role.
# The back office authenticates with its own PIN, so this key is how the server reaches the
# database. Never commit it and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Back-office login: any 6 digits you choose.
ADMIN_PIN=

# Random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# LINE Messaging API (server only). From LINE Developers → your Messaging API channel:
# Basic settings → Channel secret, and Messaging API → Channel access token (Issue).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app ID, so the calculator can share a quote straight into a LINE chat.
# From LINE Developers → your LINE Login channel → LIFF → the app's LIFF ID.
NEXT_PUBLIC_LIFF_ID=

# Facebook Messenger. From Meta for Developers → your app → App settings → Basic:
# the App ID (public) and the App secret (server only, never in the browser).
# With these two set, the Page itself is connected from the back office by logging in to
# Facebook — no token to copy by hand.
FB_APP_ID=
FB_APP_SECRET=

# A verify token you make up yourself, then type into Meta when adding the webhook URL.
FB_VERIFY_TOKEN=

# Optional. A Page token pasted by hand, for a deployment set up before the login button
# existed. Leave empty and connect the Page from the back office instead.
FB_PAGE_ACCESS_TOKEN=
